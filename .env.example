# --- K-Trend Analytics 서버 환경변수 (Vercel) ---

# Postgres 연결 (Vercel에서 Neon 연동 시 자동 주입). 다른 이름도 자동 인식.
POSTGRES_URL=

# 세션 서명 비밀키 (반드시 무작위 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 이메일 (쉼표 구분) — /admin 및 관리자 API 접근 허용
ADMIN_EMAILS=admin@ktrend.demo

# --- 결제: NICEpay V2 (@tpartners/payments-nicepay 계약) ---
# 운영 시크릿. Vercel Secrets에만 저장(Git 커밋 금지). 미설정 시 결제 버튼은 "미설정" 안내.
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
NICEPAY_WEBHOOK_SECRET=
NICEPAY_API_BASE=https://api.nicepay.co.kr
# 서비스 식별자 (orderId 프리픽스)
SERVICE_NAME=ktrend
SERVICE_ORDER_PREFIX=KTREND
# 정기결제 cron 인증 (openssl rand -base64 32)
CRON_SECRET=

# 슬랙 알림 (Incoming Webhook URL) — 문의·제안 발생 시 알림
SLACK_WEBHOOK_URL=

# 문의는 자동 이메일 발송 없이 DB에 적재되어 /admin에서 확인합니다.

# --- 콘텐츠 수집 파이프라인 (매니지드 스크래핑, B안 비동기) ---
# 미설정 시 큐/cron은 동작하되 실제 수집은 0건. 키 설정 시 수집 시작.
SCRAPER_PROVIDER=apify
SCRAPER_API_KEY=
APIFY_ACTOR=clockworks~tiktok-scraper
# Apify run 완료 webhook(/api/ingest/apify) 인증용 시크릿 (없으면 CRON_SECRET 사용)
INGEST_SECRET=
