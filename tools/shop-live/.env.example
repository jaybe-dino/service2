# cp .env.example .env 후 서버에서만 채우세요. .env 는 git 에 올리지 않습니다(.gitignore).

# NordVPN 수동 설정용 "service credentials" (Nord 계정 대시보드 → Manual setup → Service credentials).
# 일반 로그인 이메일/비밀번호가 아닙니다.
OPENVPN_USER=
OPENVPN_PASSWORD=

# 게이트웨이 접근 토큰(서버 전용, 32자 이상 무작위). 생성: openssl rand -base64 36
GATEWAY_ACCESS_TOKEN=

# HTTPS 역프록시로 공개할 때의 출처 (예: https://live.example.com). 비우면 Host 헤더 기준 same-origin 검사.
PUBLIC_ORIGIN=

# 호스트 루프백 포트(127.0.0.1 에만 바인딩)
GATEWAY_HOST_PORT=8080

# 쿠키 Secure 속성. HTTPS 역프록시 또는 SSH 터널(http://127.0.0.1)로만 접속하므로 기본 true 유지.
COOKIE_SECURE=true

# 로그인 세션 유효 시간(시간)
SESSION_TTL_HOURS=12
